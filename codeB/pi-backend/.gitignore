# Python ML .gitignore

# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
eggs/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Installer / dependency managers
pip-log.txt
pip-delete-this-directory.txt
poetry.lock
poetry-cache/
.pipenv/
Pipfile.lock

# Virtual environments
.env
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Editor/IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace

# Jupyter
.ipynb_checkpoints
profile_default/
ipython_config.py

# Notebook outputs (optional — remove if you want to track outputs)
*.nbconvert.ipynb

# Data, datasets and large artifacts
data/
datasets/
raw_data/
processed_data/
*.csv
*.tsv
*.parquet
*.db
*.sqlite
*.sqlite3
*.h5
*.hdf5
*.npz
*.npy

# Models / weights / checkpoints
models/
checkpoints/
checkpoints-*/
*.ckpt
*.pt
*.pth
*.pb
*.onnx
*.tflite
*.model
*.sav

# Experiment tracking / visualizations
runs/
events.out.tfevents.*
wandb/
mlruns/
tensorboard/

# Logs
logs/
*.log

# Testing / coverage / caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.cache/
.hypothesis/

# Build artifacts
*.egg
*.whl

# System files
.DS_Store
Thumbs.db
desktop.ini

# Secrets and local config
*.env
.env.local
local_settings.py
secrets.json
credentials.json